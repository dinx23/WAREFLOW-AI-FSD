{
  "name": "wareflow-ai-mern-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n API,UI -c cyan,green \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "node --watch server/index.js",
    "dev:ui": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
